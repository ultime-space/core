#!/bin/sh
# ============================================================================
# pre-commit — 提交前闸门（静态检查，不起浏览器）
# ----------------------------------------------------------------------------
# 目标：不让「新版本的源码带旧版本的产物」进入历史。
#   · build.ts --check 在内存重算产物并与工作区逐字节比对；
#   · 检出不同步时改源后重跑 `pnpm build:tokens`，不要手改产物。
# 环境不具备（没有 node）时放行并提示，不算不合格。
# 手动安装：pnpm exec vp hooks enable --hooks-dir .githooks
# ============================================================================
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v node >/dev/null 2>&1; then
  echo "⚠ pre-commit：未找到 node，跳过静态闸门（PATH=$PATH）"
  exit 0
fi

VP="$ROOT/node_modules/.bin/vp"
TSX="$ROOT/node_modules/.bin/tsx"

echo "── pre-commit：Vite+ staged（fmt / lint）─────────────────────────────"
"$VP" staged || exit 1

echo "── pre-commit：生成物同步 ───────────────────────────────────────────"
"$TSX" "$ROOT/scripts/build.ts" --check || exit 1

echo "── pre-commit：模型层守卫 ───────────────────────────────────────────"
"$TSX" "$ROOT/scripts/check-model.ts" || exit 1

echo "✓ 产物与源一致"
