{
  "name": "@ultime/core",
  "version": "0.10.0",
  "description": "Ultime · core：平台无关的设计系统内核（seed → 树 → 快照）；Web 的 CSS 只是它的一个出口",
  "keywords": [
    "color-system",
    "css-variables",
    "design-system",
    "design-tokens",
    "dtcg",
    "motion",
    "typography"
  ],
  "homepage": "https://github.com/ultime-space/core#readme",
  "bugs": {
    "url": "https://github.com/ultime-space/core/issues"
  },
  "license": "MIT",
  "author": "Ultime contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultime-space/core.git"
  },
  "bin": {
    "ultime-core": "./bin/ultime.js"
  },
  "files": [
    "bin",
    "dist",
    "tokens.css",
    "tokens.json",
    "tokens.dtcg.json",
    "kernel.json",
    "theme.example.json",
    "README.md",
    "DESIGN.md",
    "llms.txt",
    "SKILLS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./exporters": {
      "types": "./dist/exporters.d.ts",
      "import": "./dist/exporters.js"
    },
    "./studio": {
      "types": "./dist/studio.d.ts",
      "import": "./dist/studio.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "import": "./dist/seed.js"
    },
    "./package.json": "./package.json",
    "./theme.example.json": "./theme.example.json",
    "./kernel.json": "./kernel.json",
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./tokens.dtcg.json": "./tokens.dtcg.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vpx scripts/build.ts && vp pack",
    "build:tokens": "vpx scripts/build.ts",
    "build:tokens:check": "vpx scripts/build.ts --check",
    "build:lib": "vp pack",
    "ultime": "vpx src/cli/index.ts",
    "check": "vp check && vpx scripts/check-model.ts && vpx scripts/build.ts --check && ultime-checks run && pnpm cycles",
    "checks": "ultime-checks run",
    "cycles": "vp lint --import-plugin --deny=import/no-cycle src scripts",
    "test": "vp test",
    "size": "size-limit --json",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@ultime/cli": "^0.2.0",
    "@ultime/studio": "^0.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^22.20.5",
    "@ultime/checks": "^0.3.0",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "typescript": "^5.9.3",
    "unplugin-unused": "^0.6.0",
    "vite-plus": "1.6.0"
  },
  "size-limit": [
    {
      "name": "@ultime/core",
      "path": "dist/index.js"
    },
    {
      "name": "@ultime/core/exporters",
      "path": "dist/exporters.js"
    },
    {
      "name": "@ultime/core/studio",
      "path": "dist/studio.js"
    },
    {
      "name": "@ultime/core/tools",
      "path": "dist/tools.js"
    },
    {
      "name": "@ultime/core/seed",
      "path": "dist/seed.js"
    }
  ],
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.6.0"
}
